# Copy to .env. Never commit .env. Replace all REPLACE values before starting.
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
ORBIT_PORT=8080
# true for production behind HTTPS; false only for a local HTTP container smoke test.
ORBIT_SESSION_SECURE=true
ORBIT_PUBLIC_BASE_URL=https://orbit.example.com
ORBIT_REGISTRATION_ENABLED=true
ORBIT_EMAIL_VERIFICATION_REQUIRED=true
ORBIT_MAIL_ENABLED=true
ORBIT_MAIL_HOST=REPLACE_WITH_SMTP_HOST
ORBIT_MAIL_PORT=587
ORBIT_MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
ORBIT_MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
ORBIT_MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER_ADDRESS
ORBIT_MAIL_STARTTLS=true
# Base64 encoding of 32 random bytes; keep stable while messages remain queued.
ORBIT_MAIL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
